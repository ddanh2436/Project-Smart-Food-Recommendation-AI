# ============================================================
#  VietNomNom — AI service (FastAPI)  |  .env.example
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
#  On Hugging Face Spaces set these under
#  Settings > Variables and secrets (use "Secret" for keys/URIs).
# ============================================================

# --- Database (same cluster as the Backend) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=VietNomNom
COLLECTION_NAME=restaurants
REVIEWS_COLLECTION=reviews

# --- Server ---
# Hugging Face Spaces expect the app on port 7860. Locally 5000 matches
# the Backend's AI_SERVICE_URL default.
PORT=5000
HOST=0.0.0.0

# --- CORS: comma-separated allowed origins, or * for any ---
CORS_ORIGINS=*

# --- Models ---
YOLO_MODEL_PATH=best.pt
SENTIMENT_MODEL=5CD-AI/Vietnamese-Sentiment-visobert
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Claude (intent parsing, chat replies, review summaries) ---
# Get a key at console.anthropic.com. If ANTHROPIC_API_KEY is empty the
# service silently falls back to the rule-based engine, so the app keeps
# working without it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — lower is cheaper and faster.
CLAUDE_EFFORT=low
# Set to false to force the rule-based path even when a key is present.
ENABLE_LLM=true
# Set to false to skip loading the embedding model (saves ~500MB RAM on
# small Hugging Face Spaces; search falls back to TF-IDF only).
ENABLE_SEMANTIC_SEARCH=true

# --- Data refresh: seconds between reloads of the restaurant cache ---
DATA_REFRESH_SECONDS=900

# --- Upload limits ---
MAX_UPLOAD_MB=10
